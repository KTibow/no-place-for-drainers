---
import Meta from '../components/Meta.astro';
import Page from '../layouts/Page.astro';
import { href, loadRuns, loadSites } from '../data';

const runs = loadRuns();
const sites = loadSites(runs);
const latest = runs[0];
const scanned = runs.reduce((total, run) => total + run.summary.repos, 0);
---

<Page title="no place for drainers">
  <h1>Drainers, hours old.</h1>
  <p class="lede">
    A wallet drainer needs a host, and the free ones are one <code>git push</code> away. That push
    is the mistake: the deployment is anonymous, the repo behind it is not. This walks every new
    public repo on GitHub, works out where it deployed, and reads what is actually being served —
    long before anyone would think to submit it anywhere.
  </p>

  <Meta current="index">
    <b>{sites.length}</b> confirmed{' · '}
    <b>{runs.length}</b> {runs.length === 1 ? 'run' : 'runs'}{' · '}
    <b>{scanned.toLocaleString()}</b> repos walked{latest ? ` · last scan ${latest.date}` : ''}
  </Meta>

  {
    sites.length === 0 ? (
      <p class="empty">
        {
          runs.length === 0
            ? 'No scan has landed yet.'
            : latest?.summary.canaryCaught === false
              ? 'Nothing confirmed — but the last run missed its canary, so it found nothing because it was broken, not because there was nothing.'
              : `Nothing confirmed across ${runs.length === 1 ? 'the last run' : `the last ${runs.length} runs`}.`
        }
      </p>
    ) : (
      <ol class="sites">
        {sites.map((site) => (
          <li>
            <a href={href(`/s/${site.label}/`)}>
              <span class="host mono">{site.label}</span>
              <span class="what">
                {site.latest.category}
                {site.latest.brand ? ` · ${site.latest.brand}` : ''}
              </span>
              <span class="when">{site.firstSeen}</span>
            </a>
          </li>
        ))}
      </ol>
    )
  }
</Page>

<style>
  .lede {
    max-width: 44rem;
    color: var(--m3c-on-surface-variant);
    margin-block: 1rem 2.5rem;
  }

  .lede code {
    color: var(--m3c-on-surface);
  }

  .empty {
    color: var(--m3c-on-surface-variant);
    padding-block: 3rem;
  }

  .sites {
    margin-top: 0.75rem;
  }

  .sites a {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.15rem 1.5rem;
    align-items: baseline;
    padding: 0.7rem 0.75rem;
    margin-inline: -0.75rem;
    border-radius: 0.5rem;
    color: var(--m3c-on-surface);
  }

  .sites a:hover {
    background: var(--m3c-surface-container-low);
    text-decoration: none;
  }

  .host {
    font-size: 0.95rem;
    overflow-wrap: anywhere;
  }

  .what,
  .when {
    color: var(--m3c-on-surface-variant);
    font-size: 0.85rem;
  }

  .when {
    grid-column: 2;
    grid-row: 1;
    font-variant-numeric: tabular-nums;
  }
</style>
